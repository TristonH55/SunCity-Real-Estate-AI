datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  companyName   String
  role          UserRole
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobNotes      JobNote[] // ✅ NEW
  quotes        Quote[]
}

model Region {
  id    String @id @default(uuid())
  code  String @unique
  name  String

  systemPrices SystemPrice[]
  extraPrices  ExtraPrice[]
}

model System {
  id                     String   @id @default(uuid())
  brand                  String
  model                  String   
  systemType             SystemType
  tankMaterial           TankMaterial
  capacityLitres         Int
  warrantyPrimaryYears   Int
  warrantySecondaryYears Int?
  notes                  String?
  brochureUrl            String?  // link to a product brochure (R2 upload or /pdfs/... path)
  active                 Boolean  @default(true)
  archived               Boolean  @default(false) // hidden from the admin list + quotes; restorable
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  systemPrices           SystemPrice[]
  quoteOptions           QuoteOption[]
}

model SystemPrice {
  id       String @id @default(uuid())
  system   System @relation(fields: [systemId], references: [id])
  systemId String
  region   Region @relation(fields: [regionId], references: [id])
  regionId String
  price    Decimal
  active   Boolean @default(true) // per-region availability (global on/off is System.active)
}

model Extra {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  systemType  ExtraSystemType
  notes       String?
  infoText    String?   // customer-facing description of what this add-on is
  brochureUrl String?   // link to a brochure/image (R2 upload or /pdfs/... path)
  active      Boolean   @default(true)

  prices      ExtraPrice[]
}

model ExtraPrice {
  id       String @id @default(uuid())
  extra    Extra  @relation(fields: [extraId], references: [id])
  extraId  String
  region   Region @relation(fields: [regionId], references: [id])
  regionId String
  price    Decimal
}

model PricingConfirmation {
  id                String   @id @default(uuid())

  regionCode         String
  systemId           String
  insurerId          String?

  extraIds           String[] @default([])

  basePriceExGst     Decimal
  extrasTotalExGst   Decimal
  subtotalExGst      Decimal
  gst                Decimal
  totalIncGst        Decimal

  notes              String?
  images             String[] @default([])
  customerSnapshot   Json?
  createdAt          DateTime @default(now())

  notesLog           JobNote[] // ✅ NEW
  lastViewedByInsurer DateTime?
  lastViewedByAdmin   DateTime?

  crmLeadSentAt      DateTime? // null = CRM lead not yet sent / needs retry
  crmObjectSlug      String?   // UnityCRM lead slug (data.object_slug) for note/attachment traceability

  @@index([regionCode])
  @@index([systemId])
}

// New 3-option proposal/selection layer (real-estate agents).
// Quote (presented) holds up to 3 brand options; locking creates a PricingConfirmation.
model Quote {
  id               String        @id @default(uuid())
  agent            User          @relation(fields: [agentId], references: [id])
  agentId          String
  regionCode       String
  systemType       SystemType
  capacityLitres   Int
  extraIds         String[]      @default([])
  customerSnapshot Json
  status           QuoteStatus   @default(presented)
  selectedOptionId String?
  confirmationId   String?       // set on lock → the created PricingConfirmation
  createdAt        DateTime      @default(now())
  lockedAt         DateTime?

  // Homeowner self-approval (record-only e-signature; agent still finalises)
  approvedByName   String?
  approvedAt       DateTime?
  approvalIp       String?

  options          QuoteOption[]

  @@index([agentId])
  @@index([status])
}

model QuoteOption {
  id               String  @id @default(uuid())
  quote            Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId          String
  system           System  @relation(fields: [systemId], references: [id])
  systemId         String
  basePriceExGst   Decimal
  extrasTotalExGst Decimal
  subtotalExGst    Decimal
  gst              Decimal
  totalIncGst      Decimal

  @@index([quoteId])
}

model JobNote {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  message   String
  createdAt DateTime @default(now())

  job   PricingConfirmation @relation(fields: [jobId], references: [id])
  user  User                @relation(fields: [userId], references: [id])
}

enum UserRole {
  admin
  agent
}

enum QuoteStatus {
  presented
  approved
  locked
}
enum SystemType {
  electric
  heat_pump
  solar_thermosiphon
  solar_split
  gas
}

enum TankMaterial {
  mild_steel
  stainless_steel
  copper
}
enum ExtraSystemType {
  electric
  heat_pump
  solar
  all
}

// Small key/value store for site-wide settings (e.g. `gst_mode`).
model AppSetting {
  key   String @id
  value String
}