datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}







model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  companyName   String
  role          UserRole
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Region {
  id    String @id @default(uuid())
  code  String @unique
  name  String

  systemPrices SystemPrice[]
  extraPrices  ExtraPrice[]
}


model System {
  id                     String   @id @default(uuid())
  brand                  String
  model                  String   
  systemType             SystemType
  tankMaterial           TankMaterial
  capacityLitres         Int
  warrantyPrimaryYears   Int
  warrantySecondaryYears Int?
  notes                  String?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  systemPrices           SystemPrice[]
}



model SystemPrice {
  id       String @id @default(uuid())
  system   System @relation(fields: [systemId], references: [id])
  systemId String
  region   Region @relation(fields: [regionId], references: [id])
  regionId String
  price    Decimal
}

model Extra {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  systemType ExtraSystemType
  notes      String?
  active     Boolean   @default(true)

  prices     ExtraPrice[]
}

model ExtraPrice {
  id       String @id @default(uuid())
  extra    Extra  @relation(fields: [extraId], references: [id])
  extraId String
  region   Region @relation(fields: [regionId], references: [id])
  regionId String
  price    Decimal
}

model PricingConfirmation {
  id                String   @id @default(uuid())

  // Who / where
  regionCode         String
  systemId           String
  
  // ✅ ADD THIS LINE HERE
  insurerId          String?

  // What was selected
  extraIds           String[] @default([])

  // Price snapshot (ex-GST unless stated)
  basePriceExGst     Decimal
  extrasTotalExGst   Decimal
  subtotalExGst      Decimal
  gst                Decimal
  totalIncGst        Decimal

  // NEW 
  notes              String?     // internal notes
  images             String[]    @default([]) // uploaded image URLs
  customerSnapshot   Json?
  createdAt          DateTime @default(now())

  @@index([regionCode])
  @@index([systemId])
}







enum UserRole {
  admin
  insurer
}
enum SystemType {
  electric
  heat_pump
  solar_thermosiphon
  solar_split
}

enum TankMaterial {
  mild_steel
  stainless_steel
}
enum ExtraSystemType {
  electric
  heat_pump
  solar
  all
}
